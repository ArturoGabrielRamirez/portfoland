// =============================================================================
// Portfoland Prisma Schema
// =============================================================================
// Database: MongoDB Atlas
// Prisma Version: 6.19
// Compatible with Better Auth
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User Model
// =============================================================================

model User {
  id            String   @id @default(cuid()) @map("_id")
  email         String   @unique
  name          String
  image         String?
  oauthImage    String?
  username      String?  @unique
  locale        String   @default("en")
  emailVerified Boolean  @default(false)
  portfolioMode         String   @default("classic")
  onboardingCompleted   Boolean  @default(false)
  lastStreakDate        DateTime?
  currentStreak         Int      @default(0)
  bio               String?
  sectionOrder      String[] @default(["about", "experience", "skills", "projects"])
  contactLinks      Json     @default("{}")
  sectionVisibility Json     @default("{}")
  meta              Json     @default("{}")
  // GitHub sync tracking fields
  githubSyncedAt    DateTime?
  githubStats       Json?
  createdAt         DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  experiences       Experience[]
  userSkills        UserSkill[]
  skillCategories   SkillCategory[]
  projects          Project[]
  conversations     Conversation[]
  services          Service[]
  testimonials      Testimonial[]
  galleryItems      GalleryItem[]
  portfolioSettings PortfolioSettings?
  skillAssessments  SkillAssessment[]
  cvDocuments       CVDocument[]

  @@map("users")
}

// =============================================================================
// Better Auth Models
// =============================================================================

model Session {
  id        String   @id @default(cuid()) @map("_id")
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid()) @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// =============================================================================
// Timeline Feature Models
// =============================================================================

enum ExperienceType {
  WORK
  EDUCATION
  PROJECT
  CERTIFICATION
}

model Experience {
  id           String         @id @default(cuid()) @map("_id")
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ExperienceType
  title        String
  company      String
  latitude     Float
  longitude    Float
  address      String
  startDate    DateTime
  endDate      DateTime?
  description  String
  skills       String[]
  xp           Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  skillSources SkillSource[]

  @@index([userId])
  @@map("experiences")
}

// =============================================================================
// Project Showcase Feature Models
// =============================================================================

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Project {
  id               String        @id @default(cuid()) @map("_id")
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  slug             String
  description      String
  shortDescription String?
  imageUrl         String?
  technologies     String[]
  links            Json
  featured         Boolean       @default(false)
  status           ProjectStatus @default(IN_PROGRESS)
  startDate        DateTime
  endDate          DateTime?
  order            Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@map("projects")
}

// =============================================================================
// Skill Tree Feature Models
// =============================================================================

enum SourceType {
  EXPERIENCE
  MANUAL
  GITHUB
}

model Skill {
  id         String   @id @default(cuid()) @map("_id")
  name       String
  slug       String   @unique
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id])
  iconName   String?
  isCore     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userSkills UserSkill[]

  @@index([categoryId])
  @@map("skills")
}

model SkillCategory {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  slug      String
  color     String
  isDefault Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]

  @@unique([slug, userId])
  @@index([userId])
  @@map("skill_categories")
}

model UserSkill {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  totalXP   Int      @default(0)
  level     Int      @default(1)
  aiValidated          Boolean @default(false)
  githubValidated      Boolean @default(false)
  aiAssessmentValidated Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources   SkillSource[]
  assessments SkillAssessment[]

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model SkillSource {
  id           String      @id @default(cuid()) @map("_id")
  userSkillId  String
  userSkill    UserSkill   @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  sourceType   SourceType
  experienceId String?
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  xpAmount     Int
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([userSkillId])
  @@index([experienceId])
  @@map("skill_sources")
}

// =============================================================================
// AI Assessment Feature Models
// =============================================================================

enum AssessmentStatus {
  PENDING
  PASSED
  FAILED
}

model SkillAssessment {
  id            String           @id @default(cuid()) @map("_id")
  userId        String
  userSkillId   String
  skillSlug     String
  skillLevel    Int
  status        AssessmentStatus @default(PENDING)
  score         Int?
  attemptNumber Int
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSkill   UserSkill           @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  questions   AssessmentQuestion[]
  attempts    AssessmentAttempt[]

  @@index([userId])
  @@index([userSkillId])
  @@index([userId, skillSlug])
  @@map("skill_assessments")
}

model AssessmentQuestion {
  id            String          @id @default(cuid()) @map("_id")
  assessmentId  String
  questionIndex Int
  questionText  String
  options       String[]
  correctIndex  Int
  explanation   String
  createdAt     DateTime        @default(now())

  assessment SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id            String          @id @default(cuid()) @map("_id")
  assessmentId  String
  questionIndex Int
  selectedIndex Int
  isCorrect     Boolean
  answeredAt    DateTime        @default(now())

  assessment SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_attempts")
}

// =============================================================================
// AI Assistant Models
// =============================================================================

model Conversation {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("conversations")
}

enum MessageRole {
  user
  assistant
  system
  tool
}

model Message {
  id             String       @id @default(cuid()) @map("_id")
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// =============================================================================
// Classic Mode Feature Models
// =============================================================================

// PriceType enum for Service model pricing options
enum PriceType {
  FIXED
  RANGE
  STARTING_FROM
  CONTACT
}

model Service {
  id              String    @id @default(cuid()) @map("_id")
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  priceType       PriceType
  priceMin        Float?
  priceMax        Float?
  currency        String    @default("USD")
  durationMinutes Int?
  order           Int       @default(0)
  published       Boolean   @default(true)
  imageUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@map("services")
}

model Testimonial {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  clientTitle String?
  content     String
  rating      Int
  imageUrl    String?
  source      String?
  externalId  String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("testimonials")
}

model GalleryItem {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  altText   String?
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("gallery_items")
}

model PortfolioSettings {
  id            String   @id @default(cuid()) @map("_id")
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         String   @default("default")
  layoutVariant String   @default("bento")
  accentColor   String?
  fontFamily    String?
  heroStyle     String   @default("standard")
  showBranding  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("portfolio_settings")
}

// =============================================================================
// CV Generator Models
// =============================================================================

model CVDocument {
  id              String   @id @default(cuid()) @map("_id")
  userId          String
  title           String
  targetJob       String?
  jobDescription  String?
  content         Json
  analysisResults Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cv_documents")
}

// =============================================================================
// Skill Enhancement Cache Models
// =============================================================================

model SkillEnhancementCache {
  id             String   @id @default(cuid()) @map("_id")
  skillName      String
  skillLevel     Int
  locale         String   @default("en")
  nextLevelFocus String
  relatedSkills  Json
  resources      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([skillName, skillLevel, locale])
  @@index([skillName, skillLevel])
  @@map("skill_enhancement_cache")
}

model BrokenResourceUrl {
  id          String   @id @default(cuid()) @map("_id")
  url         String   @unique
  skillName   String
  skillLevel  Int
  locale      String
  reportCount Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([skillName, skillLevel])
  @@map("broken_resource_urls")
}
