                      "stroke": {
                        "align": "inside",
                        "thickness": 2,
                        "fill": "#4285F4"
                      },
                      "layout": "horizontal",
                      "gap": 12,
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "googleIcon",
                          "name": "Google Icon",
                          "width": 28,
                          "height": 28,
                          "fill": "#4285F4",
                          "cornerRadius": 6,
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "googleIconText",
                              "name": "G",
                              "fill": "#F1F5F9",
                              "content": "G",
                              "fontFamily": "Inter",
                              "fontSize": 16,
                              "fontWeight": "700"
                            }
                          ]
