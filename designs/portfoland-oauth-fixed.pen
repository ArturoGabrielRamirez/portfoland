                      "layout": "horizontal",
                      "gap": 12,
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "githubIcon",
                          "name": "GitHub Icon",
                          "width": 28,
                          "height": 28,
                          "fill": "#333333",
                          "cornerRadius": 6,
                          "layout": "vertical",
                          "justifyContent": "center",
                          "alignItems": "center",
                          "children": [
