                          "fill": "#F1F5F9",
                          "content": "Continue with LinkedIn",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "600"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "divider",
