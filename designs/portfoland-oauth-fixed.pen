{
  "version": "2.6",
  "children": [
    {
      "type": "frame",
      "id": "mainFrame",
      "x": 0,
      "y": 0,
      "name": "Portfoland OAuth Console",
      "clip": true,
      "width": 3840,
      "height": 2160,
      "fill": "#0D1421",
      "children": [
        {
          "type": "frame",
          "id": "bgGradient",
          "name": "Background Gradient",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "radial-gradient(circle at 50% 50%, #1A2332 0%, #0D1421 50%, #0A0E1A 100%)"
        },
        {
          "type": "frame",
          "id": "leftPanel",
          "name": "Left Info Panel",
          "x": 0,
          "y": 0,
          "width": 1400,
          "height": "fill_container",
          "fill": "linear-gradient(135deg, #1A2332 0%, #0D1421 100%)",
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "padding": 80,
          "children": [
            {
              "type": "frame",
              "id": "brandLogo",
              "name": "Brand Logo Container",
              "layout": "vertical",
              "gap": 32,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "logoIcon",
                  "name": "Logo Icon",
                  "width": 120,
                  "height": 120,
                  "fill": "linear-gradient(135deg, #00D4FF 0%, #D946EF 100%)",
                  "cornerRadius": 30,
                  "layout": "vertical",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "logoText",
                      "name": "Logo Text",
                      "fill": "#0D1421",
                      "content": "P",
                      "fontFamily": "Space Grotesk",
                      "fontSize": 64,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "brandName",
                  "name": "Brand Name",
                  "fill": "#00D4FF",
                  "content": "PORTFOLAND",
                  "fontFamily": "Space Grotesk",
                  "fontSize": 48,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "tagline",
                  "name": "Tagline",
                  "fill": "#94A3B8",
                  "content": "Gamified Career Storytelling",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "textAlign": "center"
                }
              ]
            },
            {
              "type": "frame",
              "id": "featuresList",
              "name": "Features List",
              "layout": "vertical",
              "gap": 24,
              "marginTop": 80,
              "children": [
                {
                  "type": "frame",
                  "id": "feature1",
                  "name": "Feature 1",
                  "layout": "horizontal",
                  "gap": 16,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "feature1Icon",
                      "name": "Feature Icon",
                      "width": 48,
                      "height": 48,
                      "fill": "#22C55E",
                      "cornerRadius": 12,
                      "layout": "vertical",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "feature1Text",
                          "name": "Check",
                          "fill": "#0D1421",
                          "content": "✓",
                          "fontFamily": "Inter",
                          "fontSize": 24
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "feature1Desc",
                      "name": "Feature Description",
                      "fill": "#F1F5F9",
                      "content": "Interactive Career Timeline",
                      "fontFamily": "Inter",
                      "fontSize": 18
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "feature2",
                  "name": "Feature 2",
                  "layout": "horizontal",
                  "gap": 16,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "feature2Icon",
                      "name": "Feature Icon",
                      "width": 48,
                      "height": 48,
                      "fill": "#8B5CF6",
                      "cornerRadius": 12,
                      "layout": "vertical",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "feature2Text",
                          "name": "Star",
                          "fill": "#0D1421",
                          "content": "⭐",
                          "fontFamily": "Inter",
                          "fontSize": 24
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "feature2Desc",
                      "name": "Feature Description",
                      "fill": "#F1F5F9",
                      "content": "AI-Powered Portfolio Generation",
                      "fontFamily": "Inter",
                      "fontSize": 18
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "feature3",
                  "name": "Feature 3",
                  "layout": "horizontal",
                  "gap": 16,
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "feature3Icon",
                      "name": "Feature Icon",
                      "width": 48,
                      "height": 48,
                      "fill": "#F59E0B",
                      "cornerRadius": 12,
                      "layout": "vertical",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "feature3Text",
                          "name": "Globe",
                          "fill": "#0D1421",
                          "content": "🌐",
                          "fontFamily": "Inter",
                          "fontSize": 24
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "feature3Desc",
                      "name": "Feature Description",
                      "fill": "#F1F5F9",
                      "content": "Custom Subdomain Hosting",
                      "fontFamily": "Inter",
                      "fontSize": 18
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "rightPanel",
          "name": "Right Auth Panel",
          "x": 1400,
          "y": 0,
          "width": 2440,
          "height": "fill_container",
          "fill": "#0D1421",
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "padding": 80,
          "children": [
            {
              "type": "frame",
              "id": "authCard",
              "name": "Auth Card",
              "width": 480,
              "layout": "vertical",
              "gap": 32,
              "padding": 40,
              "fill": "#1A2332",
              "cornerRadius": 24,
              "stroke": {
                "align": "inside",
                "thickness": 2,
                "fill": "#00D4FF"
              },
              "children": [
                {
                  "type": "text",
                  "id": "authTitle",
                  "name": "Auth Title",
                  "fill": "#00D4FF",
                  "content": "START YOUR QUEST",
                  "fontFamily": "Space Grotesk",
                  "fontSize": 28,
                  "fontWeight": "700",
                  "textAlign": "center"
                },
                {
                  "type": "text",
                  "id": "authSubtitle",
                  "name": "Auth Subtitle",
                  "fill": "#94A3B8",
                  "content": "Choose your authentication method",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "textAlign": "center"
                },
                {
                  "type": "frame",
                  "id": "oauthProviders",
                  "name": "OAuth Providers",
                  "layout": "vertical",
