// =============================================================================
// Portfoland Prisma Schema
// =============================================================================
// Database: MongoDB Atlas
// Prisma Version: 6.19
// Documentation: https://pris.ly/d/prisma-schema
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User Model
// =============================================================================
// Core user model for authentication and profile data.
// Better Auth models (Session, Account, Verification) will be added in Task 2.2.
// =============================================================================

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  name          String
  image         String?
  username      String?  @unique
  locale        String   @default("en")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

// =============================================================================
// Models to be added in subsequent tasks:
// - Task 2.2: Better Auth models (Session, Account, Verification)
// =============================================================================
