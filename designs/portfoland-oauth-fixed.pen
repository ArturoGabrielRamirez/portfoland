                    {
                      "type": "frame",
                      "id": "dividerLine2",
                      "name": "Divider Line 2",
                      "width": 150,
                      "height": 2,
                      "fill": "#1E293B",
                      "cornerRadius": 1
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "emailInput",
                  "name": "Email Input Container",
